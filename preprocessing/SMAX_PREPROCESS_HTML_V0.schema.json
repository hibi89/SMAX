{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SMAX HTML preprocessing V0, strict local review-only extraction",
  "description": "Structure only; validate cross-field provenance and source-byte parity with the matching JS validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "segments",
    "quality",
    "processing_mode",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "SMAX_PREPROCESS_HTML_V0"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "quality": {
      "$ref": "#/$defs/quality"
    },
    "processing_mode": {
      "const": "DETERMINISTIC_LOCAL"
    },
    "approval": {
      "const": "NOT_GRANTED"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sha256",
        "bytes",
        "raw_html"
      ],
      "properties": {
        "format": {
          "const": "UTF8_HTML"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "raw_html": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_line",
        "source_offset",
        "text",
        "status",
        "reason"
      ],
      "properties": {
        "source_line": {
          "type": "integer",
          "minimum": 1
        },
        "source_offset": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "READY_FOR_HUMAN_REVIEW",
            "NEEDS_REVIEW"
          ]
        },
        "reason": {
          "enum": [
            null,
            "FORMULA_LIKE_TEXT"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "READY_FOR_HUMAN_REVIEW"
            },
            "reason": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "NEEDS_REVIEW"
            },
            "reason": {
              "const": "FORMULA_LIKE_TEXT"
            }
          }
        }
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments",
        "review_segments"
      ],
      "properties": {
        "segments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "review_segments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    }
  }
}
