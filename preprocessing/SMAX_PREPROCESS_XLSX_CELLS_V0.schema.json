{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smax.local/schemas/SMAX_PREPROCESS_XLSX_CELLS_V0.schema.json",
  "title": "SMAX XLSX Cells V0 deterministic, approval-denied raw extraction",
  "description": "Structural wire contract. Use xlsx-package.mjs for cross-field invariants, source hash and optional original-byte parity.",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "sheets",
    "quality",
    "processing_mode",
    "approval"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "SMAX_PREPROCESS_XLSX_CELLS_V0"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/sheet"
      }
    },
    "quality": {
      "$ref": "#/$defs/quality"
    },
    "processing_mode": {
      "const": "DETERMINISTIC_LOCAL"
    },
    "approval": {
      "const": "NOT_GRANTED"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "format",
        "sha256",
        "bytes",
        "worksheet_paths"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "XLSX_ZIP"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 22,
          "maximum": 2097152
        },
        "worksheet_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^xl/worksheets/sheet[1-9][0-9]*\\.xml$"
          }
        }
      }
    },
    "cell": {
      "type": "object",
      "required": [
        "ref",
        "kind",
        "value",
        "formula",
        "status",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"
        },
        "kind": {
          "enum": [
            "blank",
            "text",
            "number_text",
            "boolean",
            "error"
          ]
        },
        "value": {
          "type": [
            "null",
            "string",
            "boolean"
          ]
        },
        "formula": {
          "type": [
            "null",
            "string"
          ]
        },
        "status": {
          "enum": [
            "READY_FOR_HUMAN_REVIEW",
            "NEEDS_REVIEW"
          ]
        },
        "reason": {
          "enum": [
            null,
            "FORMULA_UNEVALUATED",
            "ERROR_CELL",
            "FORMULA_LIKE_TEXT"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "formula": {
                "type": "string"
              }
            },
            "required": [
              "formula"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "blank"
              },
              "value": {
                "type": "null"
              },
              "status": {
                "const": "NEEDS_REVIEW"
              },
              "reason": {
                "const": "FORMULA_UNEVALUATED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "boolean"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "blank"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "text",
                  "number_text"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "number_text"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[Ee][+-]?\\d+)?$"
              }
            }
          }
        }
      ]
    },
    "row": {
      "type": "object",
      "required": [
        "source_row",
        "cells"
      ],
      "additionalProperties": false,
      "properties": {
        "source_row": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "cells": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/cell"
          }
        }
      }
    },
    "sheet": {
      "type": "object",
      "required": [
        "source_path",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "source_path": {
          "type": "string",
          "pattern": "^xl/worksheets/sheet[1-9][0-9]*\\.xml$"
        },
        "rows": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/row"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "sheets",
        "rows",
        "cells",
        "review_cells"
      ],
      "additionalProperties": false,
      "properties": {
        "sheets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "review_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    }
  }
}
